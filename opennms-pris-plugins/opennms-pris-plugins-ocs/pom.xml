<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.opennms</groupId>
        <artifactId>opennms-pris-plugins</artifactId>
        <version>2.2.1-SNAPSHOT</version>
    </parent>

    <artifactId>opennms-pris-plugins-ocs</artifactId>
    <packaging>jar</packaging>

    <name>OpenNMS :: Provisioning Integration Server :: Plugins :: OCS</name>

    <properties>
        <ocsInventoryClientVersion>1.0.1</ocsInventoryClientVersion>
        <!-- Legacy javax.xml.bind API for the javax-annotated OCS inventory
             model. Kept on JAXB 2.x because ocs.inventory.client is a
             third-party javax artifact; it is unrelated to the Jakarta
             requisition-model JAXB stack and must not be migrated here. -->
        <ocsJaxbApiVersion>2.3.1</ocsJaxbApiVersion>
    </properties>

    <dependencies>
        <!-- OCS-Inventory -->
        <dependency>
            <groupId>org.opennms</groupId>
            <artifactId>ocs.inventory.client</artifactId>
            <version>${ocsInventoryClientVersion}</version>
        </dependency>
        <!-- The OCS inventory model is javax.xml.bind-annotated, so this plugin
             marshals it with the legacy javax JAXB API. Pull that API from the
             distinct javax.xml.bind:jaxb-api GA so it does not collide with the
             requisition model's jakarta.xml.bind:jakarta.xml.bind-api 4.x
             (same-GA/different-version would drop one package set, e.g. in the
             aggregate javadoc). -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>${ocsJaxbApiVersion}</version>
            <exclusions>
                <!--
                    The activation classes are already provided by the
                    com.sun.activation:jakarta.activation reference
                    implementation pulled in by jaxws-rt; drop this redundant
                    API jar to avoid duplicate classes in the shaded uber-jar.
                -->
                <exclusion>
                    <groupId>javax.activation</groupId>
                    <artifactId>javax.activation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.ws</groupId>
            <artifactId>jakarta.xml.ws-api</artifactId>
            <version>2.3.3</version>
            <exclusions>
                <!--
                    The API-only jakarta.activation-api ships the same classes as the
                    com.sun.activation:jakarta.activation reference implementation pulled in
                    by jaxws-rt. Drop the redundant API jar to avoid duplicate classes in
                    the shaded uber-jar.
                -->
                <exclusion>
                    <groupId>jakarta.activation</groupId>
                    <artifactId>jakarta.activation-api</artifactId>
                </exclusion>
                <!--
                    jakarta.xml.bind-api 2.3.x still ships the javax.xml.bind
                    package, but under the same GA as the requisition model's
                    jakarta.xml.bind-api 4.x. Exclude it here so the javax API
                    is supplied solely by the distinct javax.xml.bind:jaxb-api
                    GA above and cannot clash with the 4.x jakarta API.
                -->
                <exclusion>
                    <groupId>jakarta.xml.bind</groupId>
                    <artifactId>jakarta.xml.bind-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>2.3.7</version>
            <scope>runtime</scope>
            <exclusions>
                <!--
                    jaxws-rt (and its jaxb-impl) pull jakarta.xml.bind-api 2.3.x,
                    which ships the javax.xml.bind package under the same GA as
                    the requisition model's jakarta.xml.bind-api 4.x. Exclude it
                    so the javax API is supplied solely by javax.xml.bind:jaxb-api
                    above (no duplicate classes, no 2.3.x/4.x GA clash).
                -->
                <exclusion>
                    <groupId>jakarta.xml.bind</groupId>
                    <artifactId>jakarta.xml.bind-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>opennms-pris-api</artifactId>
            <classifier>tests</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Build fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
